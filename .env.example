# Navelix 环境变量配置示例

# 运行端口（默认 3721）
PORT=3721

# 绑定主机（局域网/容器内访问建议 0.0.0.0）
HOSTNAME=0.0.0.0

# 初始管理员密码（如需自定义请设置，留空则自动生成随机强密码）
NAVELIX_ADMIN_PASSWORD=

# 可信反向代理配置（若位于 Nginx/Caddy 等反向代理之后，设为 true 以启用 X-Forwarded-For IP 解析）
TRUST_PROXY=false

# 时区配置
TZ=Asia/Shanghai

# ── PRO 授权（HMAC 签名密钥）──
# 生成/校验签名授权码（NAVPRO-xxx）所需的服务端私钥，必须 ≥ 32 字节高熵随机值。
# ⚠️ 未配置时，HMAC 签名授权码将不可用（避免"已知默认密钥"被任何人伪造）；
#    仍可通过 ENABLE_COMMUNITY_PRO=true 或通用激活码 NAV-PRO-2026 / PRO-COMMUNITY 启用 PRO。
# LICENSE_SECRET_KEY=

# 开源社区无缝模式：设为 true 即自动激活 PRO（适合自托管社区用户）
# ENABLE_COMMUNITY_PRO=false

# 固定 Key 授权：设置后用户只需输入此 Key 即可激活 PRO
# PRO_LICENSE_KEY=

# ── 商汤 SenseNova 模型用量面板 ──
# 凭据与开关现已改为「后台设置页」配置（不再使用 .env）。
# 登录后台 → 设置 → 商汤 SenseNova，填写账号/密码/Account ID 并开启面板即可。
