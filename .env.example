# Navelix 环境变量配置示例

# 运行端口（默认 3721）
PORT=3721

# 绑定主机（局域网/容器内访问建议 0.0.0.0）
HOSTNAME=0.0.0.0

# 初始管理员密码（如需自定义请设置，留空则自动生成随机强密码）
NAVELIX_ADMIN_PASSWORD=

# 可信反向代理配置（若位于 Nginx/Caddy 等反向代理之后，设为 true 以启用 X-Forwarded-For IP 解析）
TRUST_PROXY=false

# 时区配置
TZ=Asia/Shanghai

# ── 商汤 SenseNova 模型用量面板 ──
# 凭据与开关现已改为「后台设置页」配置（不再使用 .env）。
# 登录后台 → 设置 → 商汤 SenseNova，填写账号/密码/Account ID 并开启面板即可。
