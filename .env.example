# Navelix 环境变量配置示例

# 运行端口（默认 3721）
PORT=3721

# 绑定主机（局域网/容器内访问建议 0.0.0.0）
HOSTNAME=0.0.0.0

# 初始管理员密码（如需自定义请设置，留空则自动生成随机强密码）
NAVELIX_ADMIN_PASSWORD=

# 可信反向代理配置（若位于 Nginx/Caddy 等反向代理之后，设为 true）
# 同时用于 X-Forwarded-For IP 解析与写请求 CSRF 来源校验（X-Forwarded-Host / X-Forwarded-Proto）。
# TLS 在代理终结（浏览器 HTTPS、应用内部 HTTP）时必须设为 true，否则写请求因来源不匹配返回 403。
TRUST_PROXY=false

# 时区配置
TZ=Asia/Shanghai

# 本地物理备份间隔（整数小时，1–8760；默认 24）与保留数量（1–1000；默认 7）
NAVELIX_BACKUP_INTERVAL_HOURS=24
NAVELIX_MAX_BACKUPS=7
