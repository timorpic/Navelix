# Navelix 环境变量配置示例

# 运行端口（默认 3721）
PORT=3721

# 绑定主机（局域网/容器内访问建议 0.0.0.0）
HOSTNAME=0.0.0.0

# 初始管理员密码（如需自定义请设置，留空则自动生成随机强密码）
NAVELIX_ADMIN_PASSWORD=

# 可信反向代理配置（若位于 Nginx/Caddy 等反向代理之后，设为 true 以启用 X-Forwarded-For IP 解析）
TRUST_PROXY=false

# 时区配置
TZ=Asia/Shanghai

# 可选遥测：本地使用统计开关（默认开启=on，数据仅存本机 SQLite，无外发；设 off 可全局关闭，也可在后台「访问统计」页停用/清空）
NAVELIX_ANALYTICS=on

# 可选遥测：匿名周报开关（默认开启=on，每周发送一次匿名聚合统计（功能使用分布/版本/实例计数），帮助作者改进产品；
# 上报内容不含任何个人数据；设 off 可关闭。界面不提供开关，仅环境变量控制）
NAVELIX_ANALYTICS_REPORT=on

# 可选遥测：匿名周报接收端点（默认从 ee 字节码制品读取；需自建/覆盖时设置）
# NAVELIX_ANALYTICS_ENDPOINT=

# 可选遥测：匿名周报鉴权 TOKEN（默认从 ee 字节码制品读取；需自建/覆盖时设置）
# NAVELIX_ANALYTICS_TOKEN=
