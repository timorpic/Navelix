{
  "name": "navelix",
  "version": "2.8.12",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3721",
    "build": "next build",
    "start": "next start -p 3721",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=55 --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "precommit": "pnpm typecheck && pnpm lint",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm precommit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.16.0"
}
