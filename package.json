{
  "name": "navelix",
  "version": "2.10.20",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3721",
    "build": "node scripts/run-isolated.mjs build",
    "start": "next start -p 3721",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node scripts/run-isolated.mjs test",
    "test:coverage": "node scripts/run-isolated.mjs coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "precommit": "pnpm typecheck && pnpm lint",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.16.0"
}
